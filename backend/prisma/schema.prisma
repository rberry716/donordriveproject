generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum UpdateJobStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum UpdateRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SceneType {
  TOTAL
  DONATIONS
  TEAM_LEADERBOARD
  PARTICIPANT_LEADERBOARD
  HOURLY_LEADERBOARD
  HOURLY_TOTAL
  MILESTONE
  ANNOUNCEMENT
  STANDBY
}

enum LayoutTemplate {
  FULL_SCREEN
  FULL_SCREEN_BAR
  THREE_COLUMN
  THREE_COLUMN_BAR
  MAIN_SIDEBAR
  MAIN_SIDEBAR_BAR
}

enum ProgressBarType {
  PERIOD_TOTAL
  DONATION_COUNT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(OPERATOR)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model EventPasscode {
  id        String    @id @default(cuid())
  event     String
  codeHash  String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DisplayState {
  id                    String           @id @default(cuid())
  event                 String
  layoutTemplate        LayoutTemplate   @default(FULL_SCREEN)
  slots                 Json             @default("[]")
  progressBarType       ProgressBarType?
  progressBarGoal       Float?
  progressBarStartTime  DateTime?
  progressBarEndTime    DateTime?
  activeOverride        SceneType?
  overridePayload       Json?
  activeCampaignId      String?
  autoCycleEnabled      Boolean          @default(false)
  autoCycleIntervalSec  Int              @default(30)
  frozen                Boolean          @default(false)
  showDonorNames        Boolean          @default(true)
  updatedAt             DateTime         @updatedAt
}

model UpdateJob {
  id           String         @id @default(cuid())
  label        String
  campaignId   String
  sheetUrl     String
  tabName      String         @default("Sheet1")
  intervalSec  Int            @default(300)
  status       UpdateJobStatus  @default(PAUSED)
  pausedAt     DateTime?
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  fieldMappings UpdateFieldMapping[]
  checkpoint   UpdateCheckpoint?
  runs         UpdateRun[]
}

model UpdateFieldMapping {
  id            String  @id @default(cuid())
  updateJobId   String
  updateJob       UpdateJob @relation(fields: [updateJobId], references: [id], onDelete: Cascade)
  sourceField   String
  targetColumn  String
  transformRule String?
}

model UpdateCheckpoint {
  id        String   @id @default(cuid())
  updateJobId String   @unique
  updateJob   UpdateJob  @relation(fields: [updateJobId], references: [id], onDelete: Cascade)
  watermark String
  updatedAt DateTime @updatedAt
}

model UpdateRun {
  id             String        @id @default(cuid())
  updateJobId      String
  updateJob        UpdateJob       @relation(fields: [updateJobId], references: [id], onDelete: Cascade)
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  status         UpdateRunStatus @default(RUNNING)
  processedCount Int           @default(0)
  errorSummary   String?
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
}

model PerformanceMetric {
  id          String   @id @default(cuid())
  metricName  String
  value       Float
  unit        String?
  recordedAt  DateTime @default(now())

  @@index([metricName, recordedAt])
}
