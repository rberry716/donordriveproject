generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum SceneType {
  TOTAL
  DONATIONS
  TEAM_LEADERBOARD
  PARTICIPANT_LEADERBOARD
  HOURLY_LEADERBOARD
  HOURLY_TOTAL
  MILESTONE
  ANNOUNCEMENT
  STANDBY
}

enum LayoutTemplate {
  FULL_SCREEN
  FULL_SCREEN_BAR
  THREE_COLUMN
  THREE_COLUMN_BAR
  MAIN_SIDEBAR
  MAIN_SIDEBAR_BAR
}

enum ProgressBarType {
  PERIOD_TOTAL
  DONATION_COUNT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole   @default(OPERATOR)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model EventPasscode {
  id        String    @id @default(cuid())
  event     String
  codeHash  String
  active    Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DisplayState {
  id                    String           @id @default(cuid())
  event                 String
  layoutTemplate        LayoutTemplate   @default(FULL_SCREEN)
  slots                 Json             @default("[]")
  progressBarType       ProgressBarType?
  progressBarGoal       Float?
  progressBarStartTime  DateTime?
  progressBarEndTime    DateTime?
  activeOverride        SceneType?
  overridePayload       Json?
  activeCampaignId      String?
  autoCycleEnabled      Boolean          @default(false)
  autoCycleIntervalSec  Int              @default(30)
  frozen                Boolean          @default(false)
  showDonorNames        Boolean          @default(true)
  updatedAt             DateTime         @updatedAt
}

