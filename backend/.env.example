# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donordrive"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-random-64-byte-hex-string"
JWT_REFRESH_SECRET="replace-with-different-random-64-byte-hex-string"
JWT_ACCESS_TOKEN_EXPIRATION_TIME="15m"
JWT_REFRESH_TOKEN_EXPIRATION_TIME="7d"

# Server
PORT=4000
NODE_ENV=development

# DonorDrive API
DONORDRIVE_PUBLIC_API_BASE_URL="https://events.dancemarathon.com"
DONORDRIVE_RESTFUL_API_BASE_URL="https://api.donordrive.com"
DONORDRIVE_CLIENT_KEY=""
DONORDRIVE_EMAIL=""
DONORDRIVE_PASSWORD=""

# Mock server (set USE_MOCK=true for demo mode with fake data)
MOCK_SERVER_URL="http://localhost:4001"
USE_MOCK=true

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Seed defaults
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme"
DEFAULT_EVENT_PASSCODE="12345"
DEFAULT_EVENT_NAME="Demo Event"

# Token bucket limits
RESTFUL_API_CAPACITY=10
RESTFUL_API_REFILL_RATE=0.5
