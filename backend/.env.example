# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donordrive"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-random-64-byte-hex-string"
JWT_REFRESH_SECRET="replace-with-different-random-64-byte-hex-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# DonorDrive — leave blank to use mock server
DONORDRIVE_API_BASE_URL="https://api.donordrivepersonal.com"
DONORDRIVE_API_KEY=""

# Mock server (used when DONORDRIVE_API_KEY is blank)
MOCK_SERVER_URL="http://localhost:4001"
USE_MOCK=true

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"
